cat << 'EOF' > .gitignore
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Unit test / coverage reports
htmlcov/
.pytest_cache/
.coverage
.coverage.*

# Environments (Crucial for security)
.env
.venv
env/
venv/

# IDEs and editors
.vscode/
.idea/
*.swp
.DS_Store
EOF
